# [affinity.] — local secrets (copy to .env, gitignored)

# --- HealthCare.gov Marketplace API (developer.cms.gov/marketplace-api) ---
# Free key, request at the Marketplace API Key Request page. Keys rotate every 60 days
# (a new key is emailed automatically). Rate-limited. Powers plan search, doctor/facility/drug
# coverage lookups, out-of-pocket cost utilization, and Medicaid/CHIP eligibility estimates.
# MARKETPLACE_API_KEY=...
# MARKETPLACE_API_BASE=https://marketplace.api.healthcare.gov/api/v1

# --- Issuer machine-readable files (provider/formulary "ground truth" for the diff) ---
# The Machine-readable URL PUF lists every issuer's cms-data-index.json; no key needed.
# AFFINITY_ISSUER_INDEX_PUF=https://www.cms.gov/...   # plan-year MRF URL PUF (see docs/vision)

# --- eval:api-mrf-diff LIVE profile (optional) ---
# Without these, `npm run eval:api-mrf-diff` runs the deterministic bundled fixture and asserts the
# reconciliation answer key. Set MARKETPLACE_API_KEY *and* the vars below to run the real diff for
# the operator's rating area (the moat demo on live data). NPIs/RxCUIs are comma-separated.
# AFFINITY_EVAL_ZIP=00000
# AFFINITY_EVAL_INCOME=30000
# AFFINITY_EVAL_AGES=34
# AFFINITY_EVAL_YEAR=2026
# AFFINITY_EVAL_NPIS=1234567890,1987654321
# AFFINITY_EVAL_RXCUIS=617310,310965
# AFFINITY_EVAL_PLAN_ID=          # optional; defaults to the first plan returned
# AFFINITY_EVAL_MRF_PROVIDERS_URL=https://<issuer>/providers.json
# AFFINITY_EVAL_MRF_DRUGS_URL=https://<issuer>/drugs.json

# --- Database (M0+) ---
# `db:*` and Prisma load DATABASE_URL from `.env.local` first, then `.env`.
# Docker (repo root `docker compose up -d` — postgres/postgres, db affinity):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/affinity?schema=public"
# Native Postgres (Mac, no Docker):
# DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/affinity?schema=public"
# The health route degrades gracefully when DATABASE_URL is unset (database check "skipped").

# --- Runtime LLM (plain-language plan explainer) — FLAG-GATED, DEFAULT OFF ---
# Structure (matching + cost + verification) ships first; the explainer is last and flag-off.
# AFFINITY_LLM_ENABLED=1
# Provider is model-agnostic. "anthropic" (real) or "mock" (deterministic, no key).
# AFFINITY_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AFFINITY_LLM_MODEL=claude-opus-4-8

# --- Local eval profile note ---
# AFFINITY_EVAL_* above are optional and for LOCAL eval only. Keep any real values in an
# untracked .env / .env.local — they are gitignored and never deployed (Render builds from the
# repo, which never contains them). Public defaults here are synthetic.
